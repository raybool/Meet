ABLY_API_KEY=your-app.key:secret
INVITE_SIGNING_SECRET=replace-with-a-long-random-secret
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=replace-with-coturn-static-auth-secret
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional. If omitted, the app returns Google's public STUN server as a fallback.
STUN_URLS=stun:stun.l.google.com:19302
